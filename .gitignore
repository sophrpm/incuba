# ==========================================================
# C++ Y ARCHIVOS DE COMPILACIÓN
# ==========================================================

# Archivos objeto generados por el compilador.
*.o
*.obj

# Bibliotecas estáticas.
*.a
*.lib

# Bibliotecas dinámicas.
*.so
*.dll
*.dylib

# Ejecutables generados.
*.exe
*.out


# ==========================================================
# CMAKE
# ==========================================================

# Directorio principal de compilación del backend.
backend/build/

# Otros directorios de compilación que podrían crearse.
build/
cmake-build-*/

# Archivos internos generados por CMake.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile

# Base de datos de comandos de compilación.
compile_commands.json

# Dependencias descargadas mediante FetchContent.
_deps/


# ==========================================================
# FRONTEND: REACT, TYPESCRIPT Y VITE
# ==========================================================

# Dependencias descargadas con npm.
frontend/node_modules/

# Resultado de producción generado por Vite.
frontend/dist/

# Archivos temporales generados por Vite.
frontend/.vite/

# Archivos de registro de gestores de paquetes.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ==========================================================
# VARIABLES DE ENTORNO
# ==========================================================

# Archivos que pueden contener configuraciones privadas.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Se permite subir un archivo de ejemplo sin información privada.
!.env.example


# ==========================================================
# EDITORES E IDE
# ==========================================================

# Configuración local de Visual Studio Code.
.vscode/

# Configuración local de JetBrains CLion o IntelliJ.
.idea/

# Archivos temporales creados por Vim, Nano y otros editores.
*.swp
*.swo
*~


# ==========================================================
# SISTEMA OPERATIVO
# ==========================================================

# Archivos generados por macOS.
.DS_Store

# Archivos generados por Windows.
Thumbs.db
Desktop.ini


# ==========================================================
# ARCHIVOS TEMPORALES Y REGISTROS
# ==========================================================

# Archivos temporales.
*.tmp
*.temp

# Registros de ejecución.
*.log

# Archivos de respaldo.
*.bak


# ==========================================================
# ARCHIVOS GENERADOS DURANTE LAS PRUEBAS
# ==========================================================

# Archivos binarios que pudieran producirse durante pruebas futuras.
*.mia
*.dsk
*.disk

# Reportes temporales generados durante la ejecución.
reports/
output/

# Enlace local a la base de datos de compilación.
compile_commands.json